# Plantilla del .env de producción. En la VM: cópialo como .env, pon los valores reales y deja permisos 600.
# El .env real nunca se sube al repositorio.

# PostgreSQL gestionado. verify-full valida el certificado y que el nombre del servidor coincida.
DATABASE_URL=postgresql://notes:CAMBIAR@db.ejemplo.com:5432/notes?sslmode=verify-full&sslrootcert=/certs/ca.pem

RATE_LIMIT_PER_MINUTE=100

# Procesos de uvicorn en la VM. Para escalar en la misma VM basta con subirlo.
WEB_CONCURRENCY=1
